# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "ubuntu-raid5"
  config.vm.provider "virtualbox" do |vb|
    vb.name = "ubuntu-raid5"
    vb.memory = 1024
    vb.cpus = 1

    disk1 = File.join(Dir.pwd, "disk1.vdi")
    disk2 = File.join(Dir.pwd, "disk2.vdi")
    disk3 = File.join(Dir.pwd, "disk3.vdi")

    vb.customize ["createhd", "--filename", disk1, "--size", 1024] unless File.exist?(disk1)
    vb.customize ["createhd", "--filename", disk2, "--size", 1024] unless File.exist?(disk2)
    vb.customize ["createhd", "--filename", disk3, "--size", 1024] unless File.exist?(disk3)

    # Añadir discos extra en la misma controladora SCSI del disco de arranque
    vb.customize ["storageattach", :id, "--storagectl", "SCSI", "--port", "2", "--device", "0", "--type", "hdd", "--medium", disk1]
    vb.customize ["storageattach", :id, "--storagectl", "SCSI", "--port", "3", "--device", "0", "--type", "hdd", "--medium", disk2]
    vb.customize ["storageattach", :id, "--storagectl", "SCSI", "--port", "4", "--device", "0", "--type", "hdd", "--medium", disk3]
  end
end
