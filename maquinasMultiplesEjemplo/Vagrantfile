# -*- mode: ruby -*-
# vi: set ft=ruby :
Vagrant.configure("2") do |config|


  config.vm.define "javi" do |javi|
    javi.vm.box = "ubuntu/focal64"
    javi.vm.hostname = "javi"

    # ubuntu1.vm.network "private_network", type: "dhcp"

    javi.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

  config.vm.define "garcia" do |garcia|
    garcia.vm.box = "ubuntu/jammy64"
    garcia.vm.hostname = "garcia"

    # ubuntu2.vm.network "private_network", type: "dhcp"

    garcia.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

end

